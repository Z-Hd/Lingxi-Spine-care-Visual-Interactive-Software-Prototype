            <item>
             <widget class="QSlider" name="coronalSlider">
              <property name="styleSheet">
               <string notr="true">QSlider::groove:vertical {
    background: #000000;    /* 黑色滑轨 */
    width: 10px;            /* 滑轨宽度 */
    border-radius: 5px;     /* 圆角 */
    margin: 0px;
}

QSlider::handle:vertical {
    background: #1E88E5;    /* 深蓝色滑块 (非墨蓝) */
    border: none;           /* 无边框 */
    width: 16px;            /* 滑块宽度 */
    height: 30px;           /* 滑块长度 */
    margin: 0px 0;          /* 滑块位置 */
    border-radius: 5px;     /* 圆角 */
}

QSlider::handle:vertical:hover {
    background: #42A5F5;    /* 悬停时亮深蓝色 */
}

QSlider::handle:vertical:pressed {
    background: #0D47A1;    /* 按下时更深蓝色 */
}</string>
              </property>
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
             </widget>
