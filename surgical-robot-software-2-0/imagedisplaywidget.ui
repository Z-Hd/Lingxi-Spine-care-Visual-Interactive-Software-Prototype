            <item>
             <widget class="QSlider" name="transverseSlider">
              <property name="styleSheet">
               <string notr="true">QSlider::groove:vertical {
    background: #000000;    /* 黑色滑轨 */
    width: 10px;            /* 滑轨宽度 */
    border-radius: 5px;     /* 圆角 */
    margin: 0px;
}

QSlider::handle:vertical {
    background: #8A2BE2;    /* 紫色滑块 */
    border: none;           /* 无边框 */
    width: 16px;            /* 滑块宽度 */
    height: 30px;           /* 缩短的滑块长度 */
    margin: 0px 0;         /* 调整滑块位置 */
    border-radius: 5px;     /* 圆角 */
}

QSlider::handle:vertical:hover {
    background: #9C4DE8;    /* 悬停时亮紫色 */
}

QSlider::handle:vertical:pressed {
    background: #7B17D9;    /* 按下时深紫色 */
}</string>
              </property>
              <property name="pageStep">
               <number>10</number>
              </property>
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
             </widget>
