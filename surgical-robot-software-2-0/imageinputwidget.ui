              <property name="styleSheet">
               <string notr="true">QSlider::groove:vertical {
    background: #000000;    /* 黑色滑轨 */
    width: 10px;            /* 稍微加宽的滑轨 */
    border-radius: 5px;     /* 圆角与滑块一致 */
    margin: 0px;
}

QSlider::handle:vertical {
    background: #AAAAAA;    /* 灰色滑块 */
    border: none;           /* 无边框 */
    width: 16px;            /* 滑块宽度 */
    height: 45px;           /* 加长的滑块 */
    margin: 0px 0;         /* 调整滑块位置 */
    border-radius: 5px;     /* 圆角与滑轨一致 */
}

QSlider::handle:vertical:hover {
    background: #CCCCCC;    /* 悬停时亮灰色 */
}

QSlider::handle:vertical:pressed {
    background: #888888;    /* 按下时深灰色 */
}</string>
